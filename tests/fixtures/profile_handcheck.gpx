<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="randonneur-test"
  xmlns="http://www.topografix.com/GPX/1/1">
  <trk>
    <name>Hand-checkable distances</name>
    <trkseg>
      <!-- Spaced so the cumulative distance is hand-computable.
           At the equator, 0.001 deg lat ≈ 111.32 m (E-W motion adds
           a small haversine contribution we account for in the test). -->
      <trkpt lat="0.0000" lon="0.0000">
        <ele>100</ele>
      </trkpt>
      <trkpt lat="0.0010" lon="0.0000">
        <ele>110</ele>
      </trkpt>
      <trkpt lat="0.0010" lon="0.0010">
        <ele>120</ele>
      </trkpt>
      <trkpt lat="0.0020" lon="0.0010">
        <ele>130</ele>
      </trkpt>
    </trkseg>
  </trk>
</gpx>
